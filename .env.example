# Supabase project (Settings -> API). Both values are public by design —
# the anon key ships to every browser and RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one account allowed to write (must match app.admin_email in the DB)
ADMIN_EMAIL=

# Google Sheets export (Part B): service account JSON — either the raw JSON
# content or a path to the file — plus the target spreadsheet ids.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEET_ID=
GOOGLE_PRIVATE_SHEET_ID=
